<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <keepBorder>yes</keepBorder>
  </theme>
  <!-- The config goes here -->
  <core>
    <gap>0</gap>
    <keepBorder>yes</keepBorder>
  </core>
  <!-- Thumbnail-based window switcher -->
  <windowSwitcher outlines="yes" preview="no">
    <osd style="thumbnail"></osd>
  </windowSwitcher>
  <focus>
    <followMouse>yes</followMouse>
    <!-- <raiseOnFocus>yes</raiseOnFocus> -->
  </focus>
  <desktops number="5">
  </desktops>
  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
    </device>
  </libinput>
  <keyboard>
    <repeatRate>35</repeatRate>
    <repeatDelay>300</repeatDelay>
    <!-- <default></default> -->
    <!-- Core keys -->
    <keybind key="W-space">
      <action name="Execute">
        <!-- <command>vicinae toggle</command> -->
        <command>noctalia msg panel-toggle launcher</command>
      </action>
    </keybind>
    <!-- Media keys -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>noctalia msg volume-up</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>noctalia msg volume-down</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>noctalia msg volume-mute</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>noctalia msg brightness-up</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>noctalia msg brightness-down</command>
      </action>
    </keybind>
    <keybind key="W-d" layoutDependent="yes">
      <action name="ToggleShowDesktop"></action>
    </keybind>
    <!-- my keybinds -->
    <keybind key="W-Return" layoutDependent="yes">
      <action name="Execute">
        <command>ghostty</command>
      </action>
    </keybind>
    <keybind key="W-e" layoutDependent="yes">
      <action name="Execute">
        <command>emacsclient -c</command>
      </action>
    </keybind>
    <keybind key="W-q" layoutDependent="yes">
      <action name="Close"></action>
    </keybind>
    <keybind key="W-p" layoutDependent="yes">
      <action name="Execute">
        <command>vicinae vicinae://launch/clipboard/history</command>
      </action>
    </keybind>
    <keybind key="W-a" layoutDependent="yes">
      <action name="None"></action>
    </keybind>
    <keybind key="W-o" layoutDependent="yes">
      <action name="None"></action>
    </keybind>
    <!--switch to desktops -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1"></action>
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2"></action>
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3"></action>
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4"></action>
    </keybind>
    <keybind key="W-5">
      <action name="GoToDesktop" to="5"></action>
    </keybind>
    <keybind key="W-6">
      <action name="GoToDesktop" to="6"></action>
    </keybind>
    <!-- switch to next & prev desktops -->
    <keybind key="W-u" layoutDependent="yes">
      <action name="GoToDesktop" to="right"></action>
    </keybind>
    <keybind key="W-Next">
      <action name="GoToDesktop" to="right"></action>
    </keybind>
    <keybind key="W-i" layoutDependent="yes">
      <action name="GoToDesktop" to="left"></action>
    </keybind>
    <keybind key="W-Prior">
      <action name="GoToDesktop" to="left"></action>
    </keybind>
    <!-- send applications to a desktop -->
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1"></action>
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2"></action>
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3"></action>
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4"></action>
    </keybind>
    <keybind key="W-S-5">
      <action name="SendToDesktop" to="5"></action>
    </keybind>
    <keybind key="W-S-6">
      <action name="SendToDesktop" to="6"></action>
    </keybind>
    <!-- window binds -->
    <keybind key="W-equal" layoutDependent="yes">
      <action name="ResizeRelative" right="50"></action>
    </keybind>
    <keybind key="W-minus" layoutDependent="yes">
      <action name="ResizeRelative" right="-50"></action>
    </keybind>
    <keybind key="W-C-equal" layoutDependent="yes">
      <action bottom="50" name="ResizeRelative"></action>
    </keybind>
    <keybind key="W-C-minus" layoutDependent="yes">
      <action bottom="-50" name="ResizeRelative"></action>
    </keybind>
    <keybind key="W-m" layoutDependent="yes">
      <action direction="both" name="ToggleMaximize"></action>
    </keybind>
    <keybind key="W-S-f" layoutDependent="yes">
      <action name="ToggleFullscreen"></action>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"></action>
      <action name="WarpCursor" to="window"></action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"></action>
      <action name="WarpCursor" to="window"></action>
    </keybind>
    <keybind key="W-Tab">
      <action name="NextWindowImmediate"></action>
      <action name="WarpCursor" to="window"></action>
    </keybind>
    <keybind key="W-S-Tab">
      <action name="PreviousWindowImmediate"></action>
      <action name="WarpCursor" to="window"></action>
    </keybind>
    <keybind key="W-c" layoutDependent="yes">
      <action name="AutoPlace" policy="center"></action>
    </keybind>
    <!-- screenrecord and screenshot -->
    <keybind key="Print">
      <action name="Execute">
        <!-- <command>flameshot gui</command> -->
        <command>noctalia msg screenshot-region</command>
      </action>
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="yes">
      <action name="ToggleDecorations"></action>
    </windowRule>
  </windowRules>
  <windowSwitcher>
    <fields>
      <field content="type" width="20%"></field>
      <field content="desktop_entry_name" width="30%"></field>
      <field content="title" width="50%"></field>
    </fields>
  </windowSwitcher>
</labwc_config>
