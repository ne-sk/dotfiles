# custom-shader = shaders/cursor-smear.glsl
# custom-shader = shaders/northern-lights.glsl
# custom-shader = shaders/bloom.glsl
# custom-shader = shaders/cosmic-bg.glsl

# fonts
font-family = "JetBrainsMono Nerd Font Mono"
font-family-bold = "JetBrainsMono Nerd Font Mono"
font-family-italic = "Maple Mono NF"
font-family-bold-italic = "Maple Mono NF"
font-size = 11.5
adjust-underline-position = 3

# mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# theme
theme = Everforest Dark Hard
cursor-invert-fg-bg = true
window-theme = ghostty
split-divider-color = #33CCFF
unfocused-split-opacity = 0.6

# window
gtk-single-instance = true
window-decoration = false

# startup command
# command = tmux new-session -A -s main
# other
copy-on-select = clipboard

# keybinds
keybind = performable:ctrl+arrow_up=goto_split:up
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+arrow_down=goto_split:down
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+arrow_left=goto_split:left
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+arrow_right=goto_split:right
keybind = performable:ctrl+l=goto_split:right
