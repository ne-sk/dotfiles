# fonts
font-family = "JetBrains Mono Nerd Font"
font-family-bold = "JetBrains Mono Nerd Font"
font-family-italic = "Maple Mono NF"
font-family-bold-italic = "Maple Mono NF"
font-size = 11.5
adjust-underline-position = 3

# mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# theme
theme = gruvbox-material-hard-dark
cursor-invert-fg-bg = true
window-theme = ghostty
split-divider-color = #33CCFF
unfocused-split-opacity = 0.6

# window
gtk-single-instance = true
window-decoration = false

# startup command
# command = tmux new-session -A -s main
# other
copy-on-select = clipboard

# keybinds
# keybind = ctrl+arrow_up=goto_split:up
# keybind = ctrl+k=goto_split:up
# keybind = ctrl+arrow_down=goto_split:down
# keybind = ctrl+j=goto_split:down
# keybind = ctrl+arrow_left=goto_split:left
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+arrow_right=goto_split:right
# keybind = ctrl+l=goto_split:right
